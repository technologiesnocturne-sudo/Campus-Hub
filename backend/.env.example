
# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Grade-check voucher price, in the smallest currency unit (pesewas). 2000 = GHS 20.00
VOUCHER_PRICE_PESEWAS=2000

# Default admin account created on first run (change the password immediately after)
SEED_ADMIN_EMAIL=admin@school.edu.gh
SEED_ADMIN_PASSWORD=ChangeMe123!
